{
  "name": "@0disoft/service-catalog-generator",
  "version": "1.0.1",
  "description": "Read-only service.yaml compiler and linter for deterministic service catalog artifacts.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/service-catalog-generator.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/0disoft/service-catalog-generator/issues"
  },
  "homepage": "https://github.com/0disoft/service-catalog-generator#readme",
  "bin": {
    "scg": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "2.9.0"
  },
  "scripts": {
    "format": "oxfmt --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \".ox*.json\" \"*.config.*\" \"action.yml\" \".github/workflows/*.yml\" \"conformance/**/*.{json,mjs,yaml}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.{mjs,d.mts}\" \"tests/**/*.ts\"",
    "format:write": "oxfmt --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \".ox*.json\" \"*.config.*\" \"action.yml\" \".github/workflows/*.yml\" \"conformance/**/*.{json,mjs,yaml}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.{mjs,d.mts}\" \"tests/**/*.ts\"",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "node node_modules/typescript/bin/tsc -b tsconfig.json && node node_modules/typescript/bin/tsc -p tsconfig.check.json --noEmit",
    "typecheck:native": "node node_modules/@typescript/native/bin/tsc -b tsconfig.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run tests/workspace.test.ts tests/schema tests/core tests/report tests/cli tests/action",
    "contract": "vitest run tests/contract",
    "build": "node node_modules/typescript/bin/tsc -b tsconfig.json && node scripts/build.mjs",
    "migration-check": "vitest run tests/contract/schema-migration.test.ts",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "consumer-conformance": "node scripts/consumer-conformance.mjs && node scripts/openfeature-consumer.mjs",
    "docs": "node scripts/check-docs.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "dependency-audit": "node scripts/dependency-audit.mjs",
    "recovery-drill": "node scripts/recovery-drill.mjs",
    "release-evidence": "node scripts/release-evidence.mjs",
    "registry-smoke": "node scripts/registry-smoke.mjs",
    "release:trust:dry-run": "node scripts/trusted-publisher-dry-run.mjs",
    "prepack": "pnpm run build",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run typecheck:native && pnpm run build && pnpm run test && pnpm run contract && pnpm run migration-check && pnpm run smoke && pnpm run consumer-conformance && pnpm run docs && pnpm run recovery-drill && pnpm run secret-scan && pnpm run dependency-audit"
  },
  "devDependencies": {
    "@0disoft/openfeature-local-provider": "1.0.0",
    "@openfeature/server-sdk": "1.22.0",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
