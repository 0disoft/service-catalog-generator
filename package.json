{
  "name": "@0disoft/service-catalog-generator",
  "version": "0.5.15",
  "description": "Read-only service.yaml compiler and linter for deterministic service catalog artifacts.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/service-catalog-generator.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/0disoft/service-catalog-generator/issues"
  },
  "homepage": "https://github.com/0disoft/service-catalog-generator#readme",
  "bin": {
    "scg": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "2.9.0"
  },
  "scripts": {
    "format": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.config.*\" \"action.yml\" \".github/workflows/*.yml\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.config.*\" \"action.yml\" \".github/workflows/*.yml\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run tests/workspace.test.ts tests/schema tests/core tests/report tests/cli tests/action",
    "contract": "vitest run tests/contract",
    "build": "tsc -b tsconfig.json && node scripts/build.mjs",
    "migration-check": "node scripts/not-configured.mjs migration-check \"No schema migrations exist yet.\"",
    "smoke": "pnpm run build && node scripts/smoke.mjs",
    "docs": "node scripts/check-docs.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "dependency-audit": "node scripts/dependency-audit.mjs",
    "recovery-drill": "node scripts/recovery-drill.mjs",
    "release-evidence": "node scripts/release-evidence.mjs",
    "release:trust:dry-run": "node scripts/trusted-publisher-dry-run.mjs",
    "prepack": "pnpm run build",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run contract && pnpm run smoke && pnpm run docs && pnpm run recovery-drill && pnpm run secret-scan && pnpm run dependency-audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.0",
    "eslint": "10.6.0",
    "prettier": "3.9.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  }
}
