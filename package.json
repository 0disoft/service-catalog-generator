{
  "name": "@0disoft/service-catalog-generator",
  "version": "0.1.0",
  "description": "Read-only service.yaml compiler and linter for deterministic service catalog artifacts.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/service-catalog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/service-catalog-generator/issues"
  },
  "homepage": "https://github.com/0disoft/service-catalog-generator#readme",
  "bin": {
    "scg": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.config.*\" \".github/workflows/*.yml\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"*.config.*\" \".github/workflows/*.yml\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run tests/workspace.test.ts tests/schema tests/core",
    "contract": "vitest run tests/contract",
    "migration-check": "node scripts/not-configured.mjs migration-check \"No schema migrations exist yet.\"",
    "smoke": "node scripts/smoke.mjs",
    "docs": "node scripts/check-docs.mjs",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run contract && pnpm run smoke && pnpm run docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.0",
    "eslint": "10.6.0",
    "prettier": "3.9.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
